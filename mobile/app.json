{
  "expo": {
    "name": "CurioX",
    "slug": "curiox",
    "version": "0.1.0",
    "scheme": "curiox",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cogniv8.curiox",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "CurioX listens when you talk to it in voice mode."
      }
    },
    "android": {
      "package": "com.cogniv8.curiox",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFB81C"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "CurioX listens when you talk to it in voice mode."
        }
      ],
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#12110F",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#12110F"
          }
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "backgroundColor": "#12110F"
  }
}
