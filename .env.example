# Copy to server/.env (server) and web/.env (web). Never commit real values.

# ---- server (set in Render, never in the client) ----
PORT=4000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/curiox_dev?retryWrites=true&w=majority
# One key, or several from different accounts separated by commas: when one is rate-limited the next is used.
GEMINI_API_KEY=
GEMINI_MODEL_MAIN=gemini-3.8-flash
GEMINI_MODEL_LITE=gemini-3.5-flash-lite
# Gemini thinking level: "" (model default), minimal, low, medium, high. 3.8-flash does not support minimal.
GEMINI_THINKING_MAIN=low
GEMINI_THINKING_LITE=minimal
# Same here: GROQ_API_KEY=key1,key2
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Speech-to-text fallback for browsers without built-in speech recognition
GROQ_STT_MODEL=whisper-large-v3-turbo
TAVILY_API_KEY=
# Comma-separated list of allowed browser origins. Browser clients only (native apps send no Origin). Expo's web preview runs on 8081.
CORS_ORIGIN=http://localhost:8081
# true = canned answers and demo sources, no outside AI/search calls
DEMO_MODE=false
# Optional tuning
LLM_TIMEOUT_MS=30000
# Provider order for every model call. Groq first is much faster on the free tiers; Gemini is the fallback.
LLM_CHAT_ORDER=groq,gemini
SEARCH_CACHE_TTL_HOURS=6
# Signs account tokens. Set a long random string in production; unset means tokens stop working on each restart.
AUTH_SECRET=

# ---- mobile (mobile/.env) ----
# Leave EXPO_PUBLIC_API_URL unset in development: the app finds the laptop's API on its own.
# Set it for a hosted API, e.g. the Render URL.
# EXPO_PUBLIC_API_URL=https://your-api.onrender.com
