# Copy to server/.env (server) and web/.env (web). Never commit real values.

# ---- server (set in Render, never in the client) ----
PORT=4000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/curiox_dev?retryWrites=true&w=majority
GEMINI_API_KEY=
GEMINI_MODEL_MAIN=gemini-3.8-flash
GEMINI_MODEL_LITE=gemini-3.5-flash-lite
# Gemini thinking level: "" (model default), minimal, low, medium, high. 3.8-flash does not support minimal.
GEMINI_THINKING_MAIN=low
GEMINI_THINKING_LITE=minimal
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Speech-to-text fallback for browsers without built-in speech recognition
GROQ_STT_MODEL=whisper-large-v3-turbo
TAVILY_API_KEY=
# Comma-separated list of allowed web origins
CORS_ORIGIN=http://localhost:5173
# true = canned answers and demo sources, no outside AI/search calls
DEMO_MODE=false
# Optional tuning
LLM_TIMEOUT_MS=30000
# Streamed chat provider order. groq,gemini gives much faster visible streaming on the free tiers.
LLM_CHAT_ORDER=gemini,groq
SEARCH_CACHE_TTL_HOURS=6

# ---- web ----
VITE_API_URL=http://localhost:4000

# ---- mobile (stretch) ----
EXPO_PUBLIC_API_URL=http://<laptop-ip>:4000
